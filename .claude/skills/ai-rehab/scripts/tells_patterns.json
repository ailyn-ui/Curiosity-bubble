    {
      "id": "contrast_pivot",
      "label": "\"It's not X, it's Y\" pivots",
      "kind": "regex",
      "flags": "i",
      "items": [
        "\\b(?:it|this|that)(?:'s| is| was)\\s+not\\b[^.!?\\n—–]{1,80}(?:[.,;:]|\\s[—–])\\s*(?:it|this|that)(?:'s| is| was)\\b",
        "\\bisn't about\\b[^.!?\\n—–]{1,80}(?:[.,;:]|\\s[—–])\\s*it's about\\b",
        "\\bnot (?:just|only|merely|simply)\\b[^.!?\\n]{1,80}\\bbut\\b",
        "\\byou don't need\\b[^.!?\\n]{1,60}[.,;]\\s*you need\\b",
        "\\brather than merely\\b",
        "\\bnot simply\\b",
        "\\bis not just\\b",
        "\\bless \\w+, more \\w+\\b"
      ]
    },
    {
      "id": "ing_tail",
      "label": "Trailing \"-ing\" verdicts",
      "kind": "regex",
      "flags": "i",
      "items": [
        ",\\s+(?:highlighting|underscoring|emphasizing|reflecting|showcasing|ensuring|fostering|cementing|solidifying)\\b"
      ]
    },
    {
      "id": "colon_label",
      "label": "Colon labels",
      "kind": "regex",
      "flags": "im",
      "items": [
